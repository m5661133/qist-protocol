# انسخ هذا الملف إلى .env واملأ القيم
# لا تشارك .env أبداً — يحتوي مفتاحك الخاص

# RPC لـ Sepolia (من Alchemy أو Infura أو غيرهما)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# مفتاحك الخاص (محفظة اختبار فقط — لا تستخدم محفظة حقيقية)
PRIVATE_KEY=your_private_key_here

# مفتاح Etherscan للتحقق من العقد (اختياري)
ETHERSCAN_API_KEY=your_etherscan_key
